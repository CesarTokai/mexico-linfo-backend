# Copiar a .env y rellenar. El .env NO se commitea.

# --- Base de datos ---
DB_NAME=mexico_lindo_tours
DB_USER=mexicolindo
DB_PASSWORD=cambiame
DB_ROOT_PASSWORD=cambiame-tambien

# --- Seguridad ---
# Generar con: openssl rand -base64 64
# La aplicacion NO arranca si falta o es demasiado corto.
JWT_SECRET=

# --- Frontend ---
# Origenes que pueden llamar a la API, separados por coma.
CORS_ORIGENES=https://mexicolindotours.com,https://www.mexicolindotours.com

# --- Reservas ---
RESERVAS_HORAS_PARA_PAGAR=48
RESERVAS_PORCENTAJE_ANTICIPO=50

# --- Notificaciones (opcional) ---
NOTIFICACIONES_HABILITADO=false
NOTIFICACIONES_CORREO_OPERACION=
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
